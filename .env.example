# ---------------------------------------------------------------------------
# iNikola website — environment
# Copy to .env (or set these in your CI / hosting provider) and rebuild.
# Everything below is optional: the site works without it, but leads will fall
# back to opening the visitor's mail client instead of reaching a CRM.
# ---------------------------------------------------------------------------

# Where every form submission is POSTed as JSON.
# Any of these work — pick one and paste the URL:
#   Formspree     https://formspree.io/f/xxxxxxx
#   Web3Forms     https://api.web3forms.com/submit   (add access_key to the form)
#   Google Sheets deploy an Apps Script web app and paste its /exec URL
#   Zapier/Make   a catch-hook URL that writes into your CRM
#   Your own CRM  any endpoint accepting { name, email, company, ... } JSON
VITE_LEAD_ENDPOINT=

# Scheduler embedded on /book. Cal.com or Calendly link.
# Leave blank to show the demo request form instead.
# VITE_BOOKING_URL=https://cal.com/inikola/30min
VITE_BOOKING_URL=
